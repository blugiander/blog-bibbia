# Force LF line endings for all text files
* text=auto eol=lf

# Markdown files
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.json text eol=lf

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
